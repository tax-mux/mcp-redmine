# Copy to .env and fill in. Never commit .env.
# These values are injected into the container only (docker compose env_file).

REDMINE_URL=http://host.docker.internal:3000

# --- API keys (in-container only; never put in mcp.json) ---
# Admin / bootstrap key (registered as profile "default"):
REDMINE_API_KEY=

# Durable multi-profile store (compose mounts ./secrets/redmine-keys.json):
REDMINE_API_KEYS_FILE=/secrets/redmine-keys.json

# Optional JSON override/extend:
# REDMINE_API_KEYS={"default":"...","cursor":"..."}

# Default profile when tools omit `profile` and no X-Redmine-Profile header
# REDMINE_PROFILE=default

# Optional MCP listen settings (defaults shown)
# MCP_BIND=0.0.0.0
# MCP_PORT=8080
